# ===========================================
# REQUIRED: Razorpay Configuration
# Get your keys from https://dashboard.razorpay.com/app/keys
# ===========================================

# Server-side keys (keep secret!)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Client-side key (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Optional: Webhook secret for payment webhooks
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# ===========================================
# REQUIRED: Site Configuration
# ===========================================

# Your production domain (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://peptideclarity.in

# ===========================================
# OPTIONAL: Analytics
# ===========================================

# Plausible Analytics domain (leave empty to disable)
# Sign up at https://plausible.io (free tier: 10K pageviews/month)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=peptideclarity.in
